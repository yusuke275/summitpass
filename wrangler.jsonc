{
  "name": "summitpass",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summitpass-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "summitpass-storage"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://summitpass.pages.dev"
  }
}
